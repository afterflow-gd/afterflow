[Unit]
Description=Afterflow real kitty terminal launcher
After=graphical-session.target hyprland-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/bin/bash %h/.local/bin/afterflow-terminal-watch.sh
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
